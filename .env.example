# HeyGenAlly Backend Environment Variables
# Copy this file to .env and fill in your values

# Security
SECRET_KEY=your-secret-key-here

# API Keys
GROQ_API_KEY=your-groq-api-key
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
NVIDIA_API_KEY=your-nvidia-api-key

# LiveKit Configuration
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
# Contact centre telephony uses the self-hosted stack in telephony/ (see telephony/README.md):
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=agentconnect_dev_secret_change_me_0123456789

# Redis: websocket fan-out across processes (needed for live call events from the voice process)
REDIS_URL=redis://localhost:6379/0
# High availability (telephony/HA.md): Redis Sentinel instead of REDIS_URL, and all LiveKit nodes
# REDIS_SENTINELS=10.0.0.11:26379,10.0.0.12:26379,10.0.0.13:26379
# REDIS_SENTINEL_MASTER=agentconnect
# REDIS_PASSWORD=
# LIVEKIT_URLS=ws://10.0.0.11:7880,ws://10.0.0.12:7880
# LIVEKIT_PUBLIC_URLS=wss://lk-a.example.com,wss://lk-b.example.com

# Telephony (LiveKit SIP). Restrict who can send calls in: softphone / SIP provider IPs or CIDRs.
TELEPHONY_SIP_ALLOWED_ADDRESSES=
TELEPHONY_SIP_AUTH_USERNAME=
TELEPHONY_SIP_AUTH_PASSWORD=
TELEPHONY_VOICE_IDLE_PROCESSES=2          # warm voice processes = peak simultaneous AI / IVR calls
TELEPHONY_RINGING_TIMEOUT_SECONDS=45       # direct-to-agent numbers: how long a call may ring
TELEPHONY_HANDOFF_WAIT_SECONDS=90          # AI -> human handoff: hold time before the AI takes the call back
TELEPHONY_DEEPGRAM_MODEL=nova-3
TELEPHONY_PREWARM_EMBEDDINGS=false
# LiveKit URL the agents' browsers use (if different from LIVEKIT_URL), e.g. ws://192.168.1.10:7880
LIVEKIT_PUBLIC_URL=

# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/heygenally
# DATABASE_URL=sqlite:///./app/data/heygenally.db

# Frontend URL
FRONTEND_URL=http://localhost:8080

# Social Media Integrations
WHATSAPP_VERIFY_TOKEN=your-verify-token
INSTAGRAM_VERIFY_TOKEN=your-verify-token

LINKEDIN_COMPANY_ID=your-company-id
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret

GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# Local AI TTS (optional)
LOCALAI_TTS_URL=http://localhost:8082/tts

# ChromaDB
CHROMA_DB_HOST=localhost
CHROMA_DB_PORT=8001

# MinIO Storage
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=heygenally
MINIO_STRICT=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# WebSocket Configuration
WS_PING_INTERVAL=30
WS_CLEANUP_INTERVAL=60
WS_REGULAR_SESSION_TIMEOUT=1800
WS_PREVIEW_SESSION_TIMEOUT=300
WS_ENABLE_HEARTBEAT=True

# LLM Streaming Configuration
LLM_STREAMING_ENABLED=True
LLM_STREAM_TOKEN_BUFFER=1
LLM_REQUEST_TIMEOUT=120
HTTP_REQUEST_TIMEOUT=30

# Workflow Configuration
MAX_SUBWORKFLOW_DEPTH=5

################ LiveKit AI Agents Configuration ################
# Deepgram Configuration (for STT) - REQUIRED for voice agents
DEEPGRAM_API_KEY=your-deepgram-api-key

# Agent Default Settings (optional)
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_STT_PROVIDER=openai
AGENT_STT_LANGUAGE=en
AGENT_TTS_PROVIDER=openai
AGENT_TTS_VOICE=alloy
AGENT_VAD_ENABLED=true
AGENT_ALLOW_INTERRUPTIONS=true
AGENT_GREETING="Hello! I'm your AI voice assistant. How can I help you today?"
AGENT_SYSTEM_PROMPT="You are a helpful and friendly voice assistant. Keep your responses concise and natural for voice conversation."

# Silero VAD Configuration (optional - these match LiveKit defaults)
# VAD_THRESHOLD=0.5              # Speech probability threshold (0-1)
# VAD_MIN_SPEECH_MS=50           # Minimum speech duration to trigger (ms) - LiveKit: 0.05s
# VAD_MIN_SILENCE_MS=550         # Silence duration to end speech (ms) - LiveKit: 0.55s

# OpenAI Realtime API Configuration (for ultra-low latency voice ~300ms)
# Enable this for agents using OpenAI as LLM provider
OPENAI_REALTIME_ENABLED=true
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_REALTIME_VOICE=alloy     # alloy, echo, shimmer, ash, ballad, coral, sage, verse
################################################################

# Twilio/FreeSWITCH Public Host (for webhooks)
# PUBLIC_HOST=https://your-ngrok-url.ngrok-free.app

# ============================================
# Twilio SMS / Phone Verification
# Set PHONE_VERIFICATION_ENABLED=true once credentials are ready.
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PHONE_VERIFICATION_ENABLED=false

# ============================================
# System SMTP — transactional emails (email verification, signup alerts)
# Leave blank to disable email verification (signup still works).
# ============================================
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_FROM_EMAIL=
SYSTEM_SMTP_FROM_NAME=AgentConnect
SYSTEM_SMTP_USE_TLS=true

# ============================================
# Kill switches / rollback controls
# ============================================
MAINTENANCE_MODE=false
SIGNUP_PAUSED=false

# ============================================
# Sentry error monitoring
# ============================================
SENTRY_DSN=

# SIP registrar (softphone logins = users' SIP accounts); address softphones use as SIP server
TELEPHONY_SIP_REGISTRAR_ADDRESS=192.168.31.107:5080
TELEPHONY_SIP_REALM=agentconnect
# Registrar DB login: read-only role from telephony/kamailio/readonly-role.sql (falls back to DATABASE_URL)
KAMAILIO_DB_URL=postgres://sip_registrar:change-me@localhost:5432/heygenally
