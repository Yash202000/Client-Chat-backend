# Address softphones use as SIP server (public IP / DNS name), and the port. Must equal the backend's
# TELEPHONY_SIP_REGISTRAR_ADDRESS (shown to users in Contact Center -> SIP phones).
TELEPHONY_SIP_REGISTRAR_ADDRESS=sip.example.com:5080
# Must equal the backend's TELEPHONY_SIP_REALM
TELEPHONY_SIP_REALM=agentconnect
# Read-only login made with readonly-role.sql
KAMAILIO_DB_URL=postgres://sip_registrar:change-me@db.internal:5432/heygenally
# LiveKit SIP nodes (comma separated host:port). Calls are spread over them; a failed node is skipped.
LIVEKIT_SIP_ADDRESSES=10.0.0.11:5060,10.0.0.12:5060
# High availability (../HA.md): unique id per registrar, and the other registrar(s) sharing the database
SIP_SERVER_ID=1
SIP_PEERS=
SIP_MAX_EXPIRES=600
# Local IP to bind when the public address is not on this machine (cloud / NAT); auto-detected if empty
SIP_LISTEN_IP=
# SIP over TLS on 5081 (PortSIP "TLS"): uncomment and mount the files (see docker-compose.deploy.yml)
# SIP_TLS_CERT=/certs/fullchain.pem
# SIP_TLS_KEY=/certs/privkey.pem
# SIP_TLS_PORT=5081
# Blocking: failed logins per IP, ban length, max requests per IP per 2s
SIP_MAX_AUTH_FAILURES=10
SIP_BAN_SECONDS=900
SIP_FLOOD_REQUESTS=60
SIP_LOG_LEVEL=2
